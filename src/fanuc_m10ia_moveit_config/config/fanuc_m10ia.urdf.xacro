<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fanuc_m10ia">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import fanuc_m10ia urdf file -->
    <xacro:include filename="$(find fanuc_m10ia_support)/urdf/m10ia.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="fanuc_m10ia.ros2_control.xacro" />


    <xacro:fanuc_m10ia_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
